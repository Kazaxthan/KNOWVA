NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/publication_system
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Optional: true only when behind a trusted HTTPS reverse proxy
TRUST_PROXY=false
# Optional SMTP email delivery. Without these, emails are NOT sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional AI parsing. Use a NEW key after rotating the exposed key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# If SMTP is absent, verification links are printed only in DEV server logs.
# Never use that fallback in production.

# Optional initial administrator (used only by npm run admin:create)
# Set as temporary terminal environment variables, not committed values.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
